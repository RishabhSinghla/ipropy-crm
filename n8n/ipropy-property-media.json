      ]
    },
    "One photo at a time": {
      "main": [
        [
          {
            "node": "Tell the CRM",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Download it",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download it": {
      "main": [
        [
          {
            "node": "Website size",
            "type": "main",
            "index": 0
          },
          {
            "node": "Compressed copy",
            "type": "main",
            "index": 0
          },
          {
            "node": "Watermarked copy",
            "type": "main",
            "index": 0
          },
          {
            "node": "Social size",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Website size": {
      "main": [
        [
          {
            "node": "Save for website",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Compressed copy": {
      "main": [
        [
          {
            "node": "Save compressed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Watermarked copy": {
      "main": [
        [
          {
            "node": "Save watermarked",
            "type": "main",
