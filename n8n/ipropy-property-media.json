{
  "name": "iPropy \u2014 property media",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ipropy-property-media",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Property finished",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -400,
        300
      ],
      "webhookId": "a1000000-0000-4000-8000-000000000001"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": true, \"property\": $json.body.propertyId } }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Answer at once",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        -180,
        140
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "r1",
              "name": "root",
              "value": "=/data/properties/{{ $json.body.folder }}",
              "type": "string"
            },
            {
              "id": "r2",
              "name": "propertyId",
              "value": "={{ $json.body.propertyId }}",
              "type": "string"
            },
            {
              "id": "r3",
              "name": "crmBaseUrl",
              "value": "={{ $json.body.crmBaseUrl }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Work out the folder",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -180,
        380
      ]
    },
    {
      "parameters": {
        "fileSelector": "={{ $json.root }}/01_RAW_UPLOADS/PHOTOS/*",
        "options": {
          "fileName": true
        }
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Read the originals",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        60,
        380
      ]
    },
    {
      "parameters": {
        "operation": "resize",
        "width": 1920,
        "height": 1920,
        "resizeOption": "onlyIfLarger",
        "options": {
          "format": "jpeg",
          "quality": 82
        }
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Make the website copy",
      "type": "n8n-nodes-base.editImage",
      "typeVersion": 1,
      "position": [
        300,
        60
      ]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "={{ $('Work out the folder').first().json.root }}/07_WEBSITE/{{ $binary.data.fileName.replace(/\\.[^.]+$/, '') }}-web.jpg",
        "dataPropertyName": "data",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Save the website copy",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        540,
        60
      ]
    },
    {
      "parameters": {
        "operation": "resize",
        "width": 1080,
        "height": 1350,
        "resizeOption": "ignoreAspectRatio",
        "options": {
          "format": "jpeg",
          "quality": 86
        }
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Make the Instagram post",
      "type": "n8n-nodes-base.editImage",
      "typeVersion": 1,
      "position": [
        300,
        260
      ]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "={{ $('Work out the folder').first().json.root }}/04_SOCIAL/INSTAGRAM/FEED/{{ $binary.data.fileName.replace(/\\.[^.]+$/, '') }}-feed.jpg",
        "dataPropertyName": "data",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "Save the Instagram post",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        540,
        260
      ]
    },
    {
      "parameters": {
        "operation": "resize",
        "width": 1080,
        "height": 1920,
        "resizeOption": "ignoreAspectRatio",
        "options": {
          "format": "jpeg",
          "quality": 86
        }
      },
      "id": "a1000000-0000-4000-8000-000000000009",
      "name": "Make the Instagram story",
      "type": "n8n-nodes-base.editImage",
      "typeVersion": 1,
      "position": [
        300,
        460
      ]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "={{ $('Work out the folder').first().json.root }}/04_SOCIAL/INSTAGRAM/STORIES/{{ $binary.data.fileName.replace(/\\.[^.]+$/, '') }}-story.jpg",
        "dataPropertyName": "data",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000010",
      "name": "Save the Instagram story",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        540,
        460
      ]
    },
    {
      "parameters": {
        "operation": "text",
        "text": "iPropy",
        "fontSize": 48,
        "fontColor": "#FFFFFF",
        "positionX": 40,
        "positionY": 40,
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000011",
      "name": "Stamp the watermark",
      "type": "n8n-nodes-base.editImage",
      "typeVersion": 1,
      "position": [
        300,
        660
      ]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "={{ $('Work out the folder').first().json.root }}/03_EDITED_MEDIA/WATERMARKED/{{ $binary.data.fileName.replace(/\\.[^.]+$/, '') }}-wm.jpg",
        "dataPropertyName": "data",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000012",
      "name": "Save the watermarked copy",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        540,
        660
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Work out the folder').first().json.crmBaseUrl }}/api/webhooks/n8n/property-media-ready",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ propertyId: $('Work out the folder').first().json.propertyId }) }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000013",
      "name": "Tell the CRM it is done",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        360
      ]
    }
  ],
