{
  "name": "iPropy \u2014 property media (local OneDrive)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ipropy-property-finished",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "property-finished",
      "name": "Property finished",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -520,
        300
      ],
      "webhookId": "ipropy-property-finished"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ accepted: true, propertyId: $json.body.propertyId }) }}",
        "options": {}
      },
      "id": "answer-at-once",
      "name": "Answer at once",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        -300,
        140
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "p",
              "name": "propertyId",
              "value": "={{ $json.body.propertyId }}",
              "type": "string"
            },
            {
              "id": "c",
              "name": "crmBaseUrl",
              "value": "={{ $json.body.crmBaseUrl }}",
              "type": "string"
            },
            {
              "id": "f",
              "name": "folderName",
              "value": "={{ ($json.body.folder || '').split('/').filter(Boolean).pop() }}",
              "type": "string"
            },
            {
              "id": "r",
              "name": "root",
              "value": "/Users/rishabhsinghla/OneDrive/IPROPY-PROPERTIES",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "work-out-the-folder",
      "name": "Work out the folder",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -300,
        420
      ]
    },
    {
      "parameters": {
        "executeOnce": true,
        "command": "={{ `set -e\nROOT='${$json.root}'\nNAME='${$json.folderName}'\nBASE=$(find \"$ROOT\" -maxdepth 2 -type d -name \"$NAME\" | head -1)\ntest -n \"$BASE\" || { echo \"no folder called $NAME under $ROOT\"; exit 1; }\nSRC=\"$BASE/01 Originals\"\ntest -d \"$SRC\" || { echo \"no '01 Originals' in $BASE\"; exit 1; }\nmkdir -p \"$BASE/02 Compressed\" \"$BASE/03 Watermarked\" \"$BASE/05 CRM Website\" \\\\\n  \"$BASE/04 Social Media/Instagram Feed\" \"$BASE/04 Social Media/WhatsApp\"\nshopt -s nullglob nocaseglob\ncount=0\nfor f in \"$SRC\"/*.{jpg,jpeg,png,heic,webp}; do\n  stem=$(basename \"$f\"); stem=\"${stem%.*}\"\n  sips -s format jpeg -Z 2560 \"$f\" --out \"$BASE/02 Compressed/$stem.jpg\" >/dev/null\n  sips -s format jpeg -Z 1600 \"$f\" --out \"$BASE/05 CRM Website/$stem.jpg\" >/dev/null\n  sips -s format jpeg -Z 1080 \"$f\" --out \"$BASE/04 Social Media/Instagram Feed/$stem.jpg\" >/dev/null\n  sips -s format jpeg -Z 1080 \"$f\" --out \"$BASE/04 Social Media/WhatsApp/$stem.jpg\" >/dev/null\n  cp \"$BASE/02 Compressed/$stem.jpg\" \"$BASE/03 Watermarked/$stem.jpg\"\n  count=$((count+1))\ndone\necho \"BASE=$BASE\"\necho \"DONE=$count\"\n` }}"
      },
      "id": "build-every-version",
      "name": "Build every version",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        -80,
        420
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "d",
              "name": "processed",
              "value": "={{ Number(($json.stdout.match(/DONE=(\\d+)/) || [0,0])[1]) }}",
              "type": "number"
            },
            {
              "id": "b",
              "name": "base",
              "value": "={{ ($json.stdout.match(/BASE=(.*)/) || ['',''])[1].trim() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "read-the-result",
      "name": "Read the result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        140,
        420
      ]
    },
    {
      "parameters": {
        "executeOnce": true,
        "command": "={{ `set -e\nBASE='${$json.base}'\nCRM='${$('Work out the folder').first().json.crmBaseUrl}'\nPID='${$('Work out the folder').first().json.propertyId}'\nKEY=\"$IPROPY_API_KEY\"\ntest -n \"$KEY\" || { echo 'IPROPY_API_KEY is not set in n8n'; exit 1; }\nsent=0\nfor f in \"$BASE/05 CRM Website\"/*.jpg; do\n  [ -e \"$f\" ] || continue\n  curl -sS -f -X POST \"$CRM/api/files\" \\\\\n    -H \"x-api-key: $KEY\" \\\\\n    -F \"recordId=$PID\" -F 'module=properties' \\\\\n    -F \"file=@$f\" >/dev/null && sent=$((sent+1))\ndone\necho \"SENT=$sent\"\n` }}"
      },
      "id": "send-website-copies-to-the-crm",
      "name": "Send website copies to the CRM",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        360,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Work out the folder').first().json.crmBaseUrl }}/api/webhooks/n8n/content-ready",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-n8n-secret",
              "value": "={{ $env.IPROPY_CALLBACK_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ propertyId: $('Work out the folder').first().json.propertyId, folder: $('Read the result').first().json.base, ok: true, summary: $('Read the result').first().json.processed + ' photos processed into OneDrive; website copies uploaded to the CRM.' }) }}",
        "options": {}
      },
      "id": "tell-the-crm-it-is-done",
      "name": "Tell the CRM it is done",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        580,
        420
      ]
    }
  ],
  "connections": {
    "Property finished": {
      "main": [
        [
          {
            "node": "Answer at once",
            "type": "main",
            "index": 0
          },
          {
            "node": "Work out the folder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Work out the folder": {
      "main": [
        [
          {
            "node": "Build every version",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build every version": {
      "main": [
        [
          {
            "node": "Read the result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read the result": {
      "main": [
        [
          {
            "node": "Send website copies to the CRM",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send website copies to the CRM": {
      "main": [
        [
          {
            "node": "Tell the CRM it is done",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
