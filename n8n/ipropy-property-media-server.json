{
  "name": "iPropy — property media (server)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ipropy-property-media",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Property finished",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -400,
        300
      ],
      "webhookId": "a1000000-0000-4000-8000-000000000001"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": true, \"property\": $json.body.propertyId } }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Answer at once",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        -180,
        140
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "r1",
              "name": "root",
              "value": "=/data/properties/{{ $json.body ? $json.body.folder : $json.folder }}",
              "type": "string"
            },
            {
              "id": "r2",
              "name": "propertyId",
              "value": "={{ $json.body ? $json.body.propertyId : $json.propertyId }}",
              "type": "string"
            },
            {
              "id": "r3",
              "name": "crmBaseUrl",
              "value": "={{ $json.body ? $json.body.crmBaseUrl : $env.IPROPY_CRM_URL }}",
              "type": "string"
            },
            {
              "id": "r4",
              "name": "folder",
              "value": "={{ $json.body ? $json.body.folder : $json.folder }}",
              "type": "string"
            },
            {
              "id": "r5",
              "name": "namePrefix",
              "value": "={{ $json.body ? $json.body.namePrefix : $json.namePrefix }}",
              "type": "string"
            },
            {
              "id": "r6",
              "name": "facts",
              "value": "={{ $json.body ? ($json.body.facts || {}) : ($json.facts || {}) }}",
              "type": "object"
            },
            {
              "id": "r7",
              "name": "websitePath",
              "value": "={{ ($json.body ? $json.body.websitePath : $json.websitePath) || (($json.body ? $json.body.folder : $json.folder) + '/' + ((($json.body ? $json.body.folder : $json.folder) || 'PROPERTY').split('/').filter(Boolean).pop() || 'PROPERTY').split('-')[0].toUpperCase() + '-SHAPES/4x3') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Work out the folder",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -180,
        380
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Work out the folder').first().json.crmBaseUrl }}/api/webhooks/n8n/content-ready",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ propertyId: $('Work out the folder').first().json.propertyId, folder: $('Work out the folder').first().json.root, ok: $('Process the property').first().json.ok === true, summary: $('Process the property').first().json.summary}) }}",
        "options": {},
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "x-n8n-secret",
              "value": "={{ $env.IPROPY_CALLBACK_SECRET }}"
            }
          ]
        }
      },
      "id": "a1000000-0000-4000-8000-000000000013",
      "name": "Tell the CRM it is done",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        660
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      },
      "id": "c1000000-0000-4000-8000-000000000001",
      "name": "Every couple of minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -660,
        620
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.IPROPY_CRM_URL }}/api/webhooks/n8n/pending-media",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "x-n8n-secret",
              "value": "={{ $env.IPROPY_CALLBACK_SECRET }}"
            }
          ]
        },
        "options": {}
      },
      "id": "c1000000-0000-4000-8000-000000000002",
      "name": "Ask what was finished",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -420,
        620
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "properties",
        "options": {}
      },
      "id": "c1000000-0000-4000-8000-000000000003",
      "name": "One property at a time",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        -420,
        760
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Work out the folder').first().json.crmBaseUrl }}/api/files",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.IPROPY_API_KEY }}"
            }
          ]
        },
        "contentType": "multipart-form-data",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "data"
            },
            {
              "name": "recordId",
              "value": "={{ $('Work out the folder').first().json.propertyId }}"
            },
            {
              "name": "module",
              "value": "properties"
            },
            {
              "name": "replaceExisting",
              "value": "true"
            }
          ]
        },
        "options": {}
      },
      "onError": "continueRegularOutput",
      "id": "e1000000-0000-4000-8000-000000000001",
      "name": "Send it to the CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        60
      ]
    },
    {
      "parameters": {
        "fileSelector": "=/data/properties/{{ $('Work out the folder').first().json.websitePath }}/*",
        "options": {}
      },
      "id": "b7000000-0000-4000-8000-000000000001",
      "name": "Read the website copies",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        800,
        60
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MEDIA_SERVICE_URL }}/run",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "x-media-token",
              "value": "={{ $env.MEDIA_SERVICE_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ job: 'property', folder: $('Work out the folder').first().json.folder, prefix: $('Work out the folder').first().json.namePrefix || '', facts: $('Work out the folder').first().json.facts || {}, steps: ['name', 'prepare', 'photos', 'watermark', 'reel', 'walkthrough', 'video'] }) }}",
        "options": {
          "timeout": 1800000,
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "c9000000-0000-4000-8000-000000000001",
      "name": "Process the property",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        380
      ]
    }
  ],
  "connections": {
    "Property finished": {
      "main": [
        [
          {
            "node": "Answer at once",
            "type": "main",
            "index": 0
          },
          {
            "node": "Work out the folder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Work out the folder": {
      "main": [
        [
          {
            "node": "Process the property",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Every couple of minutes": {
      "main": [
        [
          {
            "node": "Ask what was finished",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ask what was finished": {
      "main": [
        [
          {
            "node": "One property at a time",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One property at a time": {
      "main": [
        [
          {
            "node": "Work out the folder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read the website copies": {
      "main": [
        [
          {
            "node": "Send it to the CRM",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send it to the CRM": {
      "main": [
        [
          {
            "node": "Tell the CRM it is done",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process the property": {
      "main": [
        [
          {
            "node": "Read the website copies",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "id": "ipropyPropertyMediaSrv",
  "active": false
}
