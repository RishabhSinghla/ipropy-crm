<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS (launchd) daily backup for local/dev iPropy databases.

  Install:
    bash scripts/launchd/install.sh

  __REPO_ROOT__ is a placeholder. The installer fills in the real path to this
  checkout, which is why this file must not be copied into ~/Library/LaunchAgents
  by hand: an absolute path written here works on exactly one machine, and when it
  is wrong launchd reports exit 127 and backs up nothing. Runs daily at 02:00.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ipropy.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>bash</string>
    <string>__REPO_ROOT__/scripts/db-backup.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>2</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/tmp/ipropy-backup.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/ipropy-backup.err.log</string>
</dict>
</plist>
