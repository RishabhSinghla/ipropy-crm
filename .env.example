# ---------------------------------------------------------------------------
# iPropy CRM — environment configuration
# Copy to .env and fill in. Only DATABASE_URL and JWT_SECRET are required to boot.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
# Serve the built web app from the API process (containerised deployments).
SERVE_WEB=false

# --- Error reporting ---------------------------------------------------------
# Optional Sentry DSN (legacy Store API). Unset = no reporting.
SENTRY_DSN=

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://ipropy:ipropy@localhost:5432/ipropy
DATABASE_POOL_MAX=20

# --- Auth -------------------------------------------------------------------
# GENERATE a strong secret for production: `npm run secrets:generate`.
# The server refuses to boot in production with a known dev default.
JWT_SECRET=change-me-to-a-long-random-string
# Optional separate pepper for device PINs; blank uses JWT_SECRET.
PIN_PEPPER=
JWT_EXPIRES_IN=12h
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# --- Seed admin (created by `npm run db:seed`) ------------------------------
SEED_ADMIN_EMAIL=admin@ipropy.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_DEMO_DATA=true

# --- AI ----------------------------------------------------------------------
# Fill in ONE provider. Leave AI_PROVIDER blank to auto-pick whichever has a key
# (order: anthropic, gemini, groq, opencode, openrouter, openai, ollama). With none set,
# the AI layer degrades gracefully to deterministic heuristics.
# All of these can also be set from the UI: Admin → Integrations.
AI_ENABLED=true
AI_PROVIDER=
AI_MAX_TOKENS=4096

# Anthropic — best quality, paid. console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MODEL_FAST=claude-haiku-4-5-20251001

# Google Gemini — free tier, no card. Key from aistudio.google.com/apikey
# Most generous free option; note Google may train on free-tier prompts.
GEMINI_API_KEY=
# Aliases, not pinned versions — Google retires pinned ones for new keys.
GEMINI_MODEL=gemini-flash-latest
GEMINI_MODEL_FAST=gemini-flash-lite-latest

# Groq — free tier, no card, very fast. console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant

# OpenRouter — free tier, no card. openrouter.ai/keys
# `openrouter/free` is the auto-router: individual `:free` model ids are retired
# without notice, so pinning one will eventually break.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_MODEL_FAST=openrouter/free

# OpenCode Zen — one key with several free models. opencode.ai/zen
# The CRM only offers Zen models compatible with /chat/completions.
OPENCODE_API_KEY=
OPENCODE_MODEL=nemotron-3-ultra-free
OPENCODE_MODEL_FAST=deepseek-v4-flash-free

# Any other OpenAI-compatible endpoint (OpenAI, Together, Fireworks, vLLM…)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_FAST=gpt-4o-mini

# Ollama — free, local, no key. Needs `ollama serve` running.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1
OLLAMA_MODEL_FAST=llama3.1

# --- Speech-to-text (OpenAI-compatible Whisper) ------------------------------
# Without a key, call analysis keeps requiring a manually pasted transcript.
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1

# --- WhatsApp (Meta Cloud API) ----------------------------------------------
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=ipropy-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# --- Telephony --------------------------------------------------------------
# provider: twilio | exotel | knowlarity | none
TELEPHONY_PROVIDER=none

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_ID=
TWILIO_APP_SID=

EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=

# --- Email ------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="iPropy CRM <no-reply@ipropy.com>"

IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
EMAIL_IMAP_POLL_MINUTES=5

# --- Lead sources -----------------------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_VERIFY_TOKEN=ipropy-fb-verify
GOOGLE_ADS_WEBHOOK_KEY=
WEBFORM_PUBLIC_KEY=ipropy-public-webform

# --- Storage ----------------------------------------------------------------
# driver: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# OneDrive for Business / Microsoft 365. Set STORAGE_DRIVER=onedrive when
# configuring by environment instead of Admin -> Integrations.
ONEDRIVE_TENANT_ID=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
# Use either an exact drive ID or the Microsoft 365 user's email address.
ONEDRIVE_DRIVE_ID=
ONEDRIVE_DRIVE_USER=
ONEDRIVE_ROOT_FOLDER=iPropy Properties

# --- Jobs / misc ------------------------------------------------------------
ENABLE_SCHEDULER=true
SCHEDULER_TICK_SECONDS=60
LOG_LEVEL=info
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
DEFAULT_LOCALE=en-IN

# --- Browser push notifications ----------------------------------------------
# Leave blank: the server generates a VAPID keypair on first use and stores it
# in the database, so every process in a deployment shares one pair. Only set
# these to pin an existing pair — changing them invalidates every subscription
# already handed out, silently killing alerts on every device.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ipropy.com
