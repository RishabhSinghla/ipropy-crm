# ---------------------------------------------------------------------------
# iPropy CRM — environment configuration
# Copy to .env and fill in. Only DATABASE_URL and JWT_SECRET are required to boot.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://ipropy:ipropy@localhost:5432/ipropy
DATABASE_POOL_MAX=20

# --- Auth -------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# --- Seed admin (created by `npm run db:seed`) ------------------------------
SEED_ADMIN_EMAIL=admin@ipropy.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_DEMO_DATA=true

# --- AI (Anthropic Claude) --------------------------------------------------
# Without a key the AI layer degrades gracefully to deterministic heuristics.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_MAX_TOKENS=4096
AI_ENABLED=true

# --- WhatsApp (Meta Cloud API) ----------------------------------------------
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=ipropy-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# --- Telephony --------------------------------------------------------------
# provider: twilio | exotel | knowlarity | none
TELEPHONY_PROVIDER=none

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_ID=
TWILIO_APP_SID=

EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=

# --- Email ------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="iPropy CRM <no-reply@ipropy.com>"

IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# --- Lead sources -----------------------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_VERIFY_TOKEN=ipropy-fb-verify
GOOGLE_ADS_WEBHOOK_KEY=
WEBFORM_PUBLIC_KEY=ipropy-public-webform

# --- Storage ----------------------------------------------------------------
# driver: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# --- Jobs / misc ------------------------------------------------------------
ENABLE_SCHEDULER=true
SCHEDULER_TICK_SECONDS=60
LOG_LEVEL=info
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
DEFAULT_LOCALE=en-IN
