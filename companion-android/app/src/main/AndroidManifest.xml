<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      READ_CALL_LOG is the whole app. Google Play restricts it to apps whose
      core function is call management; a CRM dialer companion qualifies but
      needs a Permissions Declaration on the listing. Sideloading to your own
      team avoids that review entirely — see the README.
    -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <!--
      Location, and the two-step Android actually enforces.

      FINE and COARSE can be asked for in a dialog. BACKGROUND cannot — from
      Android 10 the person has to open Settings themselves and choose "Allow
      all the time", and an app that asks for all three at once gets refused the
      third silently. MainActivity does them in order and sends the user to
      Settings for the last one, because a permission that was never granted and
      never mentioned is how a feature is discovered broken weeks later.

      `maxSdkVersion` is absent on purpose: this app is sideloaded to a known
      team, so there is no Play review to satisfy, but every one of these still
      has to be granted by hand on each handset.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
