# Copy to .env beside docker-compose.yml and fill in. Never commit the real one.

# Where the property media folders live on the host.
#
# On the owner's Mac this is the OneDrive sync folder. On a server there is no
# OneDrive client, so it is an rclone mount of the same personal OneDrive —
# rclone authenticates once in a browser and keeps a refresh token, which is
# what makes a personal account work at all. App-only Microsoft auth is business
# accounts only, which is the wall this hit the first time.
MEDIA_PATH=/mnt/ipropy-properties

# The CRM. n8n reaches out to this; nothing reaches in, which is why none of
# this needs a public address or a port forwarded.
IPROPY_CRM_URL=https://ipropy-crm.onrender.com

# Shared with the CRM, under Admin integrations, provider n8n.
IPROPY_CALLBACK_SECRET=

# An API key from the CRM, bound to a user. This is what lets n8n put the
# finished photos onto a property.
IPROPY_API_KEY=

# Any long random string. Only n8n and the media worker ever see it.
#   openssl rand -hex 24
MEDIA_SERVICE_TOKEN=

# Only needed once n8n is behind a domain rather than localhost.
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
