<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. This file lives under `src/debug`, so it is merged into a
  debug APK and is absent from a release one — which matters, because what it
  permits is plain HTTP.

  The reason it exists: testing a build against the API running on the
  developer's own laptop. From inside the emulator the host is 10.0.2.2, and a
  local API has no certificate, so without this every request fails with a
  cleartext-not-permitted error that reads exactly like the server being down.

  Nothing here reaches a rep's phone. A release build talks to
  https://crm.ipropy.com and nothing else, over TLS, with cleartext refused by
  the platform default.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- The emulator's alias for the machine running it. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- A real handset on the same wifi, reaching a laptop by its LAN IP. -->
        <domain includeSubdomains="false">192.168.0.0</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
