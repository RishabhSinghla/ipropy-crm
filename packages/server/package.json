{
  "name": "@ipropy/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "worker": "tsx src/worker.ts",
    "start:worker": "node dist/worker.js",
    "check:prod": "tsx src/checkProdConfig.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed/index.ts",
    "db:reset": "tsx src/db/migrate.ts --reset && tsx src/db/seed/index.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "tenant": "tsx src/control/cli.ts",
    "control": "tsx src/control/server.ts",
    "go-live:users": "tsx src/scripts/goLiveUsers.ts",
    "vtiger:discover": "tsx src/scripts/vtiger/discover.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@aws-sdk/client-s3": "^3.1126.0",
    "@ipropy/mcp": "*",
    "@ipropy/shared": "*",
    "@sentry/node": "^10.73.0",
    "@simplewebauthn/server": "^13.3.2",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "exif-reader": "^2.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.0.0",
    "imapflow": "^1.7.8",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "nodemailer": "^9.1.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "@types/yauzl": "^3.4.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0",
    "yauzl": "^3.4.0"
  }
}
