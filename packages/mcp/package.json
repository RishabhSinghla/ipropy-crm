{
  "name": "@ipropy/mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Talk to iPropy CRM from Claude, ChatGPT or any MCP client",
  "bin": {
    "ipropy-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  },
  "main": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    }
  }
}
