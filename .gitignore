# Python bytecode from the media worker
__pycache__/
*.pyc

# Linked WhatsApp sessions. These are the keys to somebody's WhatsApp account:
# anyone holding a copy can read and send as them. They live outside the repo by
# default (~/.ipropy-wa-sessions); this catches the case where WA_SESSION_DIR is
# pointed inside it.
wa-bridge/sessions/
.ipropy-wa-sessions/

# Editor temp files from network volumes (OneDrive/SMB leave these behind)
.!*

# Raw Vtiger export and the migration's checkpoint/load report — a full copy
# of a decade of business data, staged locally before it's mapped and loaded.
# Never belongs in git history.
packages/server/src/scripts/vtiger/.output/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
